{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "frontend/src",
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": [
    "frontend/next-env.d.ts",
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "frontend/.next/types/**/*.ts",
    "frontend/.next/dev/types/**/*.ts",
    "backend/database/db.js",
    "backend/database/eventSchema.js",
    "backend/database/volunteerSchema.js"
  ],
  "exclude": ["node_modules", "frontend/node_modules"]
}
